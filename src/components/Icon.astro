---
// Inline SVG icons, stroke/fill = currentColor (no literal colours). Decorative: the label sits next to the icon.
export type IconName = "phone" | "telegram" | "viber" | "mail" | "pin" | "plus" | "chevron" | "menu" | "close" | "instagram" | "facebook" | "youtube" | "tiktok";
interface Props { name: IconName; class?: string; size?: number; }
const { name, class: cls, size = 20 } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === "telegram" && <path d="M21 4.2 3.4 11c-.9.4-.9 1.6 0 1.9l4.3 1.4 1.7 5.2c.2.7 1.1.9 1.6.4l2.5-2.3 4.4 3.2c.6.4 1.5.1 1.6-.6L22.3 5.5c.2-.9-.6-1.6-1.3-1.3ZM8.2 14.2l9.3-6.4-6.8 7.6" />}
  {name === "viber" && <><path d="M12 2.8c5.4 0 8.4 2.2 8.4 7.6 0 5.4-3 7.5-8.4 7.5-.8 0-1.6 0-2.3-.2L6.4 21v-3.9C4.5 15.9 3.6 13.8 3.6 10.4 3.6 5 6.6 2.8 12 2.8Z" /><path d="M9.3 7.4c.4-.3.9-.2 1.1.2l.7 1.3c.2.4.1.8-.2 1.1l-.4.3c.4 1 1.2 1.9 2.3 2.4l.3-.4c.3-.3.7-.4 1.1-.2l1.3.7c.4.2.5.8.2 1.1-.6.8-1.5 1.1-2.4.8a7 7 0 0 1-4.6-4.6c-.3-.9 0-1.9.6-2.7Z" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === "plus" && <><path d="M12 3.5v17M3.5 12h17" /><path d="M12 9.6 14.4 12 12 14.4 9.6 12Z" fill="currentColor" stroke="none" /></>}
  {name === "chevron" && <path d="m9 5 7 7-7 7" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === "facebook" && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H9v3h2.5V21" />}
  {name === "youtube" && <><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10 9 5 3-5 3V9Z" /></>}
  {name === "tiktok" && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.3 5 4.5" />}
</svg>
