---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import pasichna from "../assets/photos/branch-pasichna.webp";
import uhorska from "../assets/photos/branch-uhorska.webp";
import Icon from "./Icon.astro";
import { branches, days, phones, labNote } from "../data/site";

const photos: Record<string, ImageMetadata> = { pasichna, uhorska };
const SUN = 6;
---
<section id="branches" class="branches" data-rec="UX-R005,G-R006" aria-labelledby="branches-title">
  <div class="container branches__in">
    <div class="branches__head">
      <h2 id="branches-title">Дві філії у Львові</h2>
      <p class="branches__intro">Однакові години в будні й суботу. У неділю відчинена лише Пасічна.</p>
    </div>

    <!-- week: days across 12 columns (desktop) -->
    <div class="week week--wide" data-reveal="fill">
      <table>
        <caption class="visually-hidden">Години роботи філій Medialt по днях тижня</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Філія</span></th>
            {days.map((d) => <th scope="col"><abbr title={d.full}>{d.short}</abbr></th>)}
          </tr>
        </thead>
        <tbody>
          {branches.map((b) => (
            <tr>
              <th scope="row">{b.street.replace("вул. ", "")}</th>
              {b.hours.map((h, i) => (
                <td class:list={["num", i === SUN && h && "is-sunday", !h && "is-off"]}>
                  {i === SUN && h ? <span class="sun">{h}</span> : h ?? "вихідний"}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- week: days down, branches across (phone) -->
    <div class="week week--narrow" data-reveal="fill">
      <table>
        <caption class="visually-hidden">Години роботи філій Medialt по днях тижня</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">День</span></th>
            {branches.map((b) => <th scope="col">{b.street.replace("вул. ", "")}</th>)}
          </tr>
        </thead>
        <tbody>
          {days.map((d, i) => (
            <tr>
              <th scope="row"><abbr title={d.full}>{d.short}</abbr></th>
              {branches.map((b) => {
                const h = b.hours[i];
                return (
                  <td class:list={["num", i === SUN && h && "is-sunday", !h && "is-off"]}>
                    {i === SUN && h ? <span class="sun">{h}</span> : h ?? "вихідний"}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="branches__lab">{labNote}</p>

    <div class="branches__cards">
      {branches.map((b) => (
        <article class="branch" aria-labelledby={`branch-${b.id}`}>
          <figure class="branch__photo" data-reveal="arch">
            <Picture
              src={photos[b.photo]}
              formats={["avif"]}
        fallbackFormat="webp"
              widths={[480, 720, 1040]}
              sizes="(min-width: 60rem) 45vw, calc(100vw - 40px)"
              alt={b.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 id={`branch-${b.id}`}>{b.name}</h3>
          <p class="branch__addr">
            <span>{b.street}, {b.complex}</span>
            <span class="branch__city">{b.city}</span>
          </p>
          <div class="branch__act">
            <a class="btn btn--secondary" href={b.map} target="_blank" rel="noopener"><Icon name="pin" /> Маршрут</a>
            <a class="btn btn--secondary" href={phones.main.href}><Icon name="phone" /> <span class="num">{phones.main.display}</span></a>
          </div>
          <div class="branch__only">
            <h4>{b.onlyLabel}</h4>
            <ul role="list">
              {b.only.map((x) => <li><Icon name="plus" size={16} />{x}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .branches { padding-block: var(--section-y); background: var(--color-surface); }
  .branches__in { display: grid; gap: var(--space-7); }
  .branches__head { display: grid; gap: var(--space-4); }
  .branches__intro { color: var(--color-muted); max-width: 44ch; }

  .week table { width: 100%; border-collapse: collapse; font-variant-numeric: lining-nums; }
  .week th, .week td { padding: var(--space-3) var(--space-2); text-align: start; border-bottom: var(--rule) solid var(--color-rule); vertical-align: middle; }
  .week thead th { font-size: var(--text-small); font-weight: var(--weight-medium); color: var(--color-muted); }
  .week abbr { text-decoration: none; }
  .week tbody th { font-weight: var(--weight-semibold); white-space: nowrap; }
  .week td { font-size: var(--text-small); white-space: nowrap; }
  .week td.is-off { color: var(--color-muted); }
  .week td.is-sunday { position: relative; padding: 0; }
  .sun {
    position: relative; display: flex; align-items: center; min-height: 48px; padding: var(--space-3) var(--space-2);
    font-weight: var(--weight-semibold); color: var(--color-accent-ink); isolation: isolate;
  }
  .sun::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--color-accent); }
  .week--wide { display: none; }

  .branches__lab { font-size: var(--text-small); color: var(--color-muted); margin-top: calc(-1 * var(--space-5)); }

  .branches__cards { display: grid; gap: var(--space-8); }
  .branch { display: grid; gap: var(--space-4); align-content: start; }
  .branch__photo { margin: 0 0 var(--space-2); overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-card) var(--radius-card) 0 0; background: var(--color-bg); }
  .branch__photo :global(picture) { display: block; height: 100%; }
  .branch__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .branch__addr { display: grid; }
  .branch__city { color: var(--color-muted); font-size: var(--text-small); }
  .branch__only { display: grid; gap: var(--space-2); }
  .branch__only h4 { margin: 0; font-size: var(--text-small); font-weight: var(--weight-medium); color: var(--color-muted); }
  .branch__only ul { display: grid; gap: var(--space-2); padding: 0; }
  .branch__only li { display: flex; gap: var(--space-2); align-items: flex-start; font-weight: var(--weight-medium); }
  .branch__only li :global(svg) { flex-shrink: 0; margin-top: 0.2em; }
  .branch__act { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block: var(--space-1) var(--space-2); }

  @media (min-width: 40rem) {
    .week td, .week th { padding-inline: var(--space-3); }
  }
  @media (min-width: 60rem) {
    .branches__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .branches__head h2 { grid-column: 1 / span 6; text-wrap: balance; }
    .branches__intro { grid-column: 8 / span 5; }
    .week--wide { display: block; }
    .week--narrow { display: none; }
    .week--wide th:first-child { width: 16%; }
    .week--wide td { font-size: var(--text-body); }
    .week--wide .sun { min-height: 64px; padding-inline: var(--space-3); }
    .branches__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
    .branch__photo { aspect-ratio: 3 / 2; border-radius: 9999px 9999px 0 0 / 50% 50% 0 0; }
  }
</style>
