---
import Icon from "./Icon.astro";
import { phones, channels } from "../data/site";
---
<nav class="callbar" aria-label="Зв'язатися з клінікою" data-rec="UX-R009,G-R006,M-R006">
  <a class="callbar__item callbar__item--main" href={phones.main.href}><Icon name="phone" /> Подзвонити</a>
  <a class="callbar__item" href={channels.telegram} target="_blank" rel="noopener"><Icon name="telegram" /> Telegram</a>
  <a class="callbar__item" href={channels.viber}><Icon name="viber" /> Viber</a>
</nav>

<style>
  .callbar {
    position: fixed; inset: auto 0 0 0; z-index: var(--z-sticky);
    display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--space-2);
    padding: var(--space-2) var(--page-x) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: var(--color-bg); border-top: var(--rule) solid var(--color-rule);
  }
  .callbar__item {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-width: 0;
    height: calc(var(--bar-h) - 2 * var(--space-2)); border-radius: var(--radius-pill);
    border: var(--border-control) solid var(--color-brand);
    font-size: var(--text-small); font-weight: var(--weight-semibold); text-decoration: none; white-space: nowrap;
    transition: transform var(--dur-micro) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }
  .callbar__item :global(svg) { flex-shrink: 0; }
  .callbar__item--main { background: var(--color-text); color: var(--color-bg); border-color: var(--color-text); }
  .callbar__item:active { transform: scale(0.98); }
  @media (max-width: 24rem) {
    .callbar { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-1); }
    .callbar__item :global(svg) { display: none; }
  }
  @media (min-width: 60rem) { .callbar { display: none; } }
  @media (prefers-reduced-motion: reduce) { .callbar__item:active { transform: none; } }
</style>
