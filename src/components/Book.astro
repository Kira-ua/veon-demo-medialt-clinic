---
import Icon from "./Icon.astro";
import { phones, channels } from "../data/site";
// Booking goes through the administrators only (C-006): no form, real channels by route (UX-R003).
const lines = [
  { who: "Вагітність", what: "Постановка на облік і пакети за триместрами", phone: phones.pregnancy },
  { who: "Хірургія", what: "Операційний координатор: консультація і розрахунок вартості", phone: phones.surgery },
  { who: "Усе інше", what: "Консультації лікарів, діти, чекапи, УЗД та аналізи", phone: phones.main, messengers: true },
];
---
<section id="book" class="book" data-rec="UX-R003,S-R009" aria-labelledby="book-title">
  <div class="container book__in">
    <div class="book__head">
      <h2 id="book-title">Один дзвінок — і ми підберемо лікаря й філію</h2>
      <p class="book__lead">Зателефонуйте або напишіть у месенджер: адміністратор запропонує зручний час.</p>
    </div>

    <ul class="lines" role="list">
      {lines.map((l) => (
        <li class="line">
          <div class="line__who">
            <h3>{l.who}</h3>
            <p>{l.what}</p>
          </div>
          <div class="line__act">
            <a class="line__phone num" href={l.phone.href}>
              <Icon name="phone" size={24} />
              {l.phone.display}
            </a>
            {l.messengers && (
              <div class="line__msg">
                <a class="btn btn--secondary btn--ink" href={channels.telegram} target="_blank" rel="noopener"><Icon name="telegram" /> Telegram</a>
                <a class="btn btn--secondary btn--ink" href={channels.viber}><Icon name="viber" /> Viber</a>
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .book { padding-block: var(--section-y); background: var(--color-accent); color: var(--color-accent-ink); }
  .book__in { display: grid; gap: var(--space-7); }
  .book__head { display: grid; gap: var(--space-4); }
  .book__lead { font-size: var(--text-lead); max-width: 36ch; }

  .lines { display: grid; padding: 0; border-top: 2px solid var(--color-text); }
  .line { display: grid; gap: var(--space-4); padding-block: var(--space-6); border-bottom: var(--rule) solid var(--color-text); }
  .line__who { display: grid; gap: var(--space-2); }
  .line__who p { color: var(--color-accent-ink); max-width: 40ch; }
  .line__act { display: grid; gap: var(--space-4); justify-items: start; }
  .line__phone {
    display: inline-flex; align-items: center; gap: var(--space-3); min-height: 48px;
    font-family: var(--font-display); font-size: var(--text-price); font-weight: var(--weight-medium); line-height: 1.1;
    text-decoration: underline 1.5px transparent; text-underline-offset: 0.18em;
    transition: text-decoration-color var(--dur-short) var(--ease-out);
  }
  .line__phone :global(svg) { flex-shrink: 0; }
  @media (hover: hover) { .line__phone:hover { text-decoration-color: currentColor; } }
  .line__msg { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .btn--ink { border-color: var(--color-text); }
  @media (hover: hover) { .btn--ink:hover { background: var(--color-text); color: var(--color-accent); border-color: var(--color-text); } }

  @media (min-width: 60rem) {
    .book__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .book__head { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + var(--space-7)); }
    .lines { grid-column: 7 / span 6; }
    .line { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .line__who { grid-column: 1 / span 3; }
    .line__act { grid-column: 4 / span 3; }
  }
</style>
